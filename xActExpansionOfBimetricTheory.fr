M$ModelName = "xActExpansionOfBimetricTheory";

M$Information = {
  Authors      -> {"Felix Herber"},
  Institutions -> {"Stockholm University"},
  Emails       -> {"felix.herber@gmail.com"},
  Date         -> "21-06-2025"
};

M$Parameters = {
    mPl == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Planck Mass"
    },
    q == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Planck Mass Ratio"
    },
    mFP == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Fierz Pauli Mass"
    },
    c == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Background Metric Parameter"
    },
    BetaBim1 == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Beta Parameter 1"
    },
    BetaBim3 == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Beta Parameter 3"
    },
    m == {
        ParameterType -> Internal,
        ComplexParameter -> False,
        Description -> "Bimetric Interaction Strength"
    }
};

M$ClassesDescription = {
  T[1] == {
      ClassName     -> G,
      ParticleName    -> G,
      PropagatorLabel -> G,
      SelfConjugate -> True,
      PropagatorArrow -> None,
      PropagatorType -> Sine,
      Mass -> 0
  },
  T[2] == {
      ClassName -> M,
      ParticleName -> M,
      PropagatorLabel -> M,
      SelfConjugate -> True,
      PropagatorArrow -> None,
      PropagatorType -> Straight,
      Mass -> mFP
  }
};

