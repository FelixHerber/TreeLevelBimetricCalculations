           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"Not", "[", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"groupElements", ",", " ", "leftProduct"}], "]"}], 
              "]"}], ",", "  ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"groupElements", ",", "leftProduct"}], "]"}]}], "]"}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"rightProduct", " ", "\[Equal]", " ", "leftProduct"}], ",",
