   RowBox[{
    RowBox[{"up", " ", "to", " ", "a", " ", 
     RowBox[{"phase", ".", " ", "Note"}], " ", "that", " ", "we", " ", "do", " ",
      "not", " ", "use", " ", "crossing", " ", "symmetry", " ", "as", " ", 
     "in", " ", "the", " ", "thesis", " ", "Herber", " ", 
     RowBox[{
      RowBox[{"(", "2025", ")"}], ".", " ", "This"}], " ", "is", " ", 
     "because", " ", "crossed", " ", "amplitudes", " ", "with", " ", "spin"}],
