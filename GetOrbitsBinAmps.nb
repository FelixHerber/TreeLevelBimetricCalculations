        RowBox[{"C", ",", "hC"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"D", ",", "hD"}], "}"}]}], "}"}], ".", " ", "The"}], " ", 
    "same", " ", "permutation", " ", "acts", " ", "on", " ", "particle", " ", 
    "labels", " ", "and", " ", 
    RowBox[{"helicities", ".", " ", "Signs"}], " ", "introduced", " ", "by", " ",
     "crossing", " ", "or", " ", "parity", " ", "are", " ", "retained", " ", 
    "for", " ", "helicities", " ", "but", " ", "removed", " ", "from", " ", 
    "the", " ", "particle", " ", "labels"}], ",", 
   RowBox[{
   "since", " ", "the", " ", "particle", " ", "species", " ", "labels", " ", 
    "themselves", " ", "are", " ", "not", " ", 
