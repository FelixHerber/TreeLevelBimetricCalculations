Cell[BoxData[
 RowBox[{
  RowBox[{"GroupAction", "[", 
   RowBox[{"groupElement_", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"particleA_", ",", "hA_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"particleB_", ",", "hB_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"particleC_", ",", "hC_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"particleD_", ",", "hD_"}], "}"}]}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "particles", ",", "helicities", ",", "newParticles", ",", 
      "newHelicities"}], "}"}], ",", 
    RowBox[{
     RowBox[{"particles", "=", 
      RowBox[{"{", 
       RowBox[{
       "particleA", ",", "particleB", ",", "particleC", ",", "particleD"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"helicities", "=", 
      RowBox[{"{", 
       RowBox[{"hA", ",", "hB", ",", "hC", ",", "hD"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newParticles", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"groupElement", ".", "particles"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newHelicities", "=", 
      RowBox[{"groupElement", ".", "helicities"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"newParticles", ",", "newHelicities"}], "}"}], "]"}]}]}], 
   "]"}]}]], "Input",
