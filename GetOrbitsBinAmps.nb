Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Convert", " ", "every", " ", "representative", " ", "to", " ", "a", " ", 
    "LaTeX", " ", "string"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"representativeTeX", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{
         RowBox[{"TeXForm", "[", "#", "]"}], ",", "InputForm"}], "]"}], "&"}],
       "/@", "scatteringProcessesSymbols"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "global", " ", "orbit", " ", "number", " ", "with", " ", 
     "representative"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"orbitTableData", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "scatteringProcessesSymbols", "]"}], "]"}], ",",
          "representativeTeX"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Split", " ", "according", " ", "to", " ", "scattering", " ", "process"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ggggData", "=", 
     RowBox[{"orbitTableData", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ggmmData", "=", 
     RowBox[{"orbitTableData", "[", 
      RowBox[{"[", 
       RowBox[{"4", ";;", "27"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gmmmData", "=", 
     RowBox[{"orbitTableData", "[", 
      RowBox[{"[", 
       RowBox[{"28", ";;", "62"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"mmmmData", "=", 
     RowBox[{"orbitTableData", "[", 
      RowBox[{"[", 
       RowBox[{"63", ";;", "100"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "GG"}], "->", " ", 
     RowBox[{"GG", " ", "table", " ", "first"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ggggRows", "=", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\< & $\>\"", "<>", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], 
           "<>", "\"\<$ \\\\\\\\\\n\\\\midrule\>\""}], "&"}], ",", 
         "ggggData"}], "]"}], ",", "\"\<\\n\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ggggTableTeX", "=", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<{\\\\small\\n\>\"", ",", "\"\<\\\\begin{table}[ht]\\n\>\"",
        ",", "\"\<\\\\centering\\n\>\"", 
       ",", "\"\<\\\\begin{tabular}{r l}\\n\>\"", 
       ",", "\"\<\\\\midrule\\n\>\"", 
       ",", "\"\<Number & Orbit representative \\\\\\\\\\n\>\"", 
       ",", "\"\<\\\\midrule\\n\>\"", ",", "ggggRows", ",", "\"\<\\n\>\"", 
       ",", "\"\<\\\\end{tabular}\\n\>\"", 
       ",", "\"\<\\\\caption{Representatives of the symmetry orbits of \>\"", 
       ",", "\"\<$G_{2\\\\to2}$ acting on $X_{2\\\\to2}$ in the $GG\\\\to GG$ \
sector.}\\n\>\"", ",", "\"\<\\\\label{tab:orbit-representatives-GGGG}\\n\>\"",
        ",", "\"\<\\\\end{table}\\n\>\"", ",", "\"\<}\\n\>\""}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "the", " ", "other", " ", "tables", " ", "are", " ", "built", 
     " ", "with", " ", "this"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeOrbitLongTable", "[", 
      RowBox[{"data_", ",", "processTeX_", ",", "label_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "numberOfEntries", ",", "halfLength", ",", "leftHalf", ",", 
         "rightHalf", ",", "numberOfMissingRows", ",", "pairedData", ",", 
         "rows"}], "}"}], ",", 
       RowBox[{
        RowBox[{"numberOfEntries", "=", 
         RowBox[{"Length", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"halfLength", "=", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"numberOfEntries", "/", "2"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Split", " ", "into", " ", "left", " ", "and", " ", "right", " ", 
          "halves"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"leftHalf", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"data", ",", "halfLength"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightHalf", "=", 
         RowBox[{"Drop", "[", 
          RowBox[{"data", ",", "halfLength"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "If", " ", "the", " ", "number", " ", "of", " ", "entries", " ", 
           "is", " ", "odd"}], ",", " ", 
          RowBox[{
          "add", " ", "complete", " ", "blank", " ", "rows", " ", "of", " ", 
           "the", " ", "form", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}], " ", "to", " ", 
           "the", " ", "right", " ", "half"}]}], "*)"}], 
        RowBox[{"numberOfMissingRows", "=", 
         RowBox[{
          RowBox[{"Length", "[", "leftHalf", "]"}], "-", 
          RowBox[{"Length", "[", "rightHalf", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"numberOfMissingRows", ">", "0"}], ",", 
          RowBox[{"rightHalf", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"rightHalf", ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}], ",", 
               "numberOfMissingRows"}], "]"}]}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Combine", " ", "corresponding", " ", 
          RowBox[{"left", "/", "right"}], " ", 
          RowBox[{"entries", ".", "Every"}], " ", "resulting", " ", "row", " ",
           "now", " ", "has", " ", "exactly", " ", "four", " ", 
          RowBox[{"elements", ":", 
           RowBox[{"{", 
            RowBox[{
            "number1", ",", "representative1", ",", "number2", ",", 
             "representative2"}], "}"}]}]}], "*)"}], 
        RowBox[{"pairedData", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Join", ",", 
           RowBox[{"{", 
            RowBox[{"leftHalf", ",", "rightHalf"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Convert", " ", "rows", " ", "to", " ", "LaTeX"}], "*)"}], 
        RowBox[{"rows", "=", 
         RowBox[{"StringRiffle", "[", 
          RowBox[{
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"row", ",", 
               RowBox[{"StringJoin", "[", 
                RowBox[{
                 RowBox[{"ToString", "[", 
                  RowBox[{"row", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\< & $\>\"",
                  ",", 
                 RowBox[{"row", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<$ & \>\"", ",", 
                 RowBox[{"(*", 
                  RowBox[{
                   RowBox[{"Empty", " ", "right"}], "-", 
                   RowBox[{
                   "hand", " ", "side", " ", "for", " ", "an", " ", "odd", " ",
                     "number", " ", "of", " ", "entries"}]}], "*)"}], 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"row", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "===", "\"\<\>\""}], 
                   ",", "\"\<\>\"", ",", 
                   RowBox[{"ToString", "[", 
                    RowBox[{"row", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], 
                 ",", "\"\< & \>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"row", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], "===", "\"\<\>\""}], 
                   ",", "\"\<\>\"", ",", 
                   RowBox[{"\"\<$\>\"", "<>", 
                    RowBox[{"row", "[", 
                    RowBox[{"[", "4", "]"}], "]"}], "<>", "\"\<$\>\""}]}], 
                  "]"}], ",", "\"\< \\\\\\\\\\n\\\\midrule\>\""}], "]"}]}], 
              "]"}], ",", "pairedData"}], "]"}], ",", "\"\<\\n\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<{\\\\small\\n\>\"", 
          ",", "\"\<\\\\setlength{\\\\tabcolsep}{5pt}\\n\>\"", 
          ",", "\"\<\\\\begin{longtable}{r l|r l}\\n\>\"", 
          ",", "\"\<\\\\caption{Representatives of the symmetry orbits of \
\>\"", ",", "\"\<$G_{2\\\\to2}$ acting on $X_{2\\\\to2}$ in the $\>\"", ",", 
          "processTeX", ",", "\"\<$ sector.}\\\\label{\>\"", ",", "label", 
          ",", "\"\<}\\\\\\\\\\n\>\"", ",", "\"\<\\\\midrule\\n\>\"", 
          ",", "\"\<Number & Orbit representative \>\"", 
          ",", "\"\<& Number & Orbit representative \\\\\\\\\\n\>\"", 
          ",", "\"\<\\\\midrule\\n\>\"", ",", "\"\<\\\\endfirsthead\\n\\n\>\"",
           ",", "\"\<\\\\multicolumn{4}{c}\>\"", 
          ",", "\"\<{{\\\\tablename\\\\ \\\\thetable{} -- continued from \
previous page}} \\\\\\\\\\n\>\"", ",", "\"\<\\\\midrule\\n\>\"", 
          ",", "\"\<Number & Orbit representative \>\"", 
          ",", "\"\<& Number & Orbit representative \\\\\\\\\\n\>\"", 
          ",", "\"\<\\\\midrule\\n\>\"", ",", "\"\<\\\\endhead\\n\\n\>\"", 
          ",", "\"\<\\\\midrule\\n\>\"", 
          ",", "\"\<\\\\multicolumn{4}{r}{{Continued on next page}} \
\\\\\\\\\\n\>\"", ",", "\"\<\\\\endfoot\\n\\n\>\"", 
          ",", "\"\<\\\\midrule\\n\>\"", ",", "\"\<\\\\endlastfoot\\n\\n\>\"",
           ",", "rows", ",", "\"\<\\n\\\\end{longtable}\\n\>\"", 
          ",", "\"\<}\\n\>\""}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "the", " ", "three", " ", "two", " ", "block", " ", 
     "tables"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ggmmTableTeX", "=", 
     RowBox[{"MakeOrbitLongTable", "[", 
      RowBox[{
      "ggmmData", ",", "\"\<GG\\\\to MM\>\"", 
       ",", "\"\<tab:orbit-representatives-GGMM\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"gmmmTableTeX", "=", 
     RowBox[{"MakeOrbitLongTable", "[", 
      RowBox[{
      "gmmmData", ",", "\"\<GM\\\\to MM\>\"", 
       ",", "\"\<tab:orbit-representatives-GMMM\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mmmmTableTeX", "=", 
     RowBox[{"MakeOrbitLongTable", "[", 
      RowBox[{
      "mmmmData", ",", "\"\<MM\\\\to MM\>\"", 
       ",", "\"\<tab:orbit-representatives-MMMM\>\""}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.99559211503191*^9, 3.9955921150445175`*^9}, 
   3.9955922963276463`*^9, {3.995592326851425*^9, 3.995592384958639*^9}, {
