Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Tries", " ", "to", " ", "put", " ", "expressions", " ", "in", " ", "a", 
    " ", "root", " ", "on", " ", "a", " ", "common", " ", "denominator", " ", 
    "and", " ", "then", " ", "splits", " ", "the", " ", "denominator", " ", 
    "from", " ", "the", " ", "numerator"}], ";", " ", 
   RowBox[{
   "depending", " ", "on", " ", "whether", " ", "either", " ", "the", " ", 
    "numerator", " ", "or", " ", "denominator", " ", "is", " ", "real"}], ";",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Or", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"A", "/", "B"}], "+", 
       RowBox[{"C", "/", "D"}]}], "]"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"DA", "+", "BC"}], ")"}], "/", "BD"}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"DA", "+", "BC"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", "BD", "]"}]}], " ", "if", " ", "BD"}], " ", ">", 
      " ", 
      RowBox[{
       RowBox[{"0", " ", "or", " ", "DA"}], " ", "+", " ", "BC"}], " ", ">", 
      " ", "0"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"If", " ", "instead", " ", "BD"}], " ", "<", " ", 
     RowBox[{
      RowBox[{"0", " ", "or", " ", "DA"}], "+", "BC"}], " ", "<", " ", 
     RowBox[{"0", " ", "it", " ", "gives", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"A", "/", "B"}], "+", 
        RowBox[{"C", "/", "D"}]}], "]"}]}]}], " ", "=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"-", "DA"}], "-", "BC"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"-", "BD"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "Input", ";", "\[IndentingNewLine]", 
   RowBox[{"rootArg", " ", "-", " ", 
    RowBox[{
    "the", " ", "argument", " ", "inside", " ", "the", " ", "root", " ", 
     "which", " ", "is", " ", "supposed", " ", "to", " ", "be", " ", "put", 
     " ", "on", " ", "a", " ", "common", " ", "denominator", " ", "and", " ", 
     "then", " ", "split"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"rootPower", " ", "-", " ", 
    RowBox[{"the", " ", "power", " ", "of", " ", "the", " ", "root"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"assumptions", " ", "-", " ", 
    RowBox[{
    "assumptions", " ", "which", " ", "state", " ", "whenever", " ", "any", 
