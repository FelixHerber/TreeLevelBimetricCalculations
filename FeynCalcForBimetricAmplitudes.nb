      RowBox[{"m1", ",", " ", "m2", ",", " ", "m3", ",", " ", "m4"}], 
      "}"}]}]}], ";", "\[IndentingNewLine]", "Output", ";", 
   "\[IndentingNewLine]", 
   RowBox[{
