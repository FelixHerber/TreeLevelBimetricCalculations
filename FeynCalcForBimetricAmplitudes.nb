Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateAssumptionsFromMasses", "[", "masses_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "m1", ",", "m2", ",", "m3", ",", "m4", ",", " ", "assumption1", ",", " ",
       "assumption2", ",", " ", "assumption3", ",", " ", "assumption4", ",", 
      "exprInsideRoot", ",", " ", "assumptionFinal"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"m1", " ", "=", " ", 
      RowBox[{"masses", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m2", "=", 
      RowBox[{"masses", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m3", "=", 
      RowBox[{"masses", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"m4", "=", 
      RowBox[{"masses", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{
        "The", " ", "expression", " ", "below", " ", "comes", " ", "from", 
         " ", "1"}], "-", 
        RowBox[{
         RowBox[{"cos\[Theta]", "^", "2"}], " ", "which", " ", "should", " ", 
         "be"}]}], " ", ">", " ", "0."}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"exprInsideRoot", "=", 
      RowBox[{
       RowBox[{"-", "4"}], " ", "s", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["m2", "4"], " ", 
          SuperscriptBox["m3", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["m1", "4"], " ", 
          SuperscriptBox["m4", "2"]}], "-", 
         RowBox[{
          SuperscriptBox["m1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox["m4", "4"]}], "+", 
            RowBox[{
             SuperscriptBox["m2", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m3", "2"], "+", 
               SuperscriptBox["m4", "2"], "-", "s"}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox["m4", "2"], " ", "s"}], "+", 
            RowBox[{
             SuperscriptBox["m3", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m4", "2"], "-", "t"}], ")"}]}], "+", 
            RowBox[{
             SuperscriptBox["m4", "2"], " ", "t"}], "+", 
            RowBox[{"s", " ", "t"}]}], ")"}]}], "+", 
         RowBox[{"s", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox["m3", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m4", "2"], "-", "t"}], ")"}]}], "+", 
            RowBox[{"t", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["m4", "2"]}], "+", "s", "+", "t"}], ")"}]}]}], 
           ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["m2", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["m3", "4"], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m4", "2"], "-", "s"}], ")"}], " ", "t"}], "-", 
            RowBox[{
             SuperscriptBox["m3", "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["m4", "2"], "+", "s", "+", "t"}], ")"}]}]}], 
           ")"}]}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PossibleZeroQ", "[", "m1", "]"}], ",", " ", 
       RowBox[{"assumption1", " ", "=", " ", 
        RowBox[{
         RowBox[{"s", " ", ">", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m1", "+", "m2"}], ")"}], "^", "2"}]}], "&&", 
         RowBox[{"s", ">", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m3", "+", "m4"}], ")"}], "^", "2"}]}]}]}], ",", " ", 
       RowBox[{"assumption1", " ", "=", " ", 
        RowBox[{
         RowBox[{"s", " ", ">", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m1", "+", "m2"}], ")"}], "^", "2"}]}], "&&", 
         RowBox[{"s", ">", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"m3", "+", "m4"}], ")"}], "^", "2"}]}], " ", "&&", " ", 
         RowBox[{"m1", " ", ">", " ", "0"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PossibleZeroQ", "[", "m2", "]"}], ",", " ", 
       RowBox[{"assumption2", " ", "=", " ", "assumption1"}], ",", " ", 
       RowBox[{"assumption2", " ", "=", " ", 
        RowBox[{"assumption1", " ", "&&", " ", 
         RowBox[{"m2", " ", ">", " ", "0"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PossibleZeroQ", "[", "m3", "]"}], ",", " ", 
       RowBox[{"assumption3", " ", "=", " ", "assumption2"}], ",", " ", 
       RowBox[{"assumption3", " ", "=", " ", 
        RowBox[{"assumption2", " ", "&&", " ", 
         RowBox[{"m3", " ", ">", " ", "0"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PossibleZeroQ", "[", "m4", "]"}], ",", " ", 
       RowBox[{"assumption4", " ", "=", " ", "assumption3"}], ",", " ", 
       RowBox[{"assumption4", " ", "=", " ", 
        RowBox[{"assumption3", " ", "&&", " ", 
         RowBox[{"m4", " ", ">", " ", "0"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"assumptionFinal", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"assumption4", "&&", 
        RowBox[{"t", "\[Element]", "Reals"}], "&&", 
        RowBox[{"exprInsideRoot", ">", "0"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "assumptionFinal"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.958359343027697*^9, 3.9583594017082224`*^9}, {
   3.9583594592077465`*^9, 3.958359459914048*^9}, {3.9589600787456737`*^9, 
