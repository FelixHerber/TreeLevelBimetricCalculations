       "the", " ", "assumptions", " ", "state", " ", "that", " ", "X"}], " ", 
      ">", " ", 
      RowBox[{"0", " ", "while", " ", "Y"}]}]}]}], ",", " ", "Z", ",", " ", 
   RowBox[{"...", " ", "are", " ", "not", " ", "real"}], ",", " ", 
