Cell[BoxData[
 RowBox[{
  RowBox[{"SimplifyDiagramWithDummyPols", "[", 
   RowBox[{
   "diagramWithDummyPols_", ",", " ", "momenta_", ",", " ", "helicities_", 
    ",", " ", "masses_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "listOfContributionsToDiagram", ",", "summedDiagram", ",", 
      "rootExpandedDiagram", ",", "simplifiedResult", ",", "assumptions", ",",
       "diagramSetKin", ",", " ", "totMassSquared", ",", " ", 
      "diagramSimplified"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"assumptions", "=", 
      RowBox[{"GenerateAssumptionsFromMasses", "[", "masses", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"listOfContributionsToDiagram", "=", 
      RowBox[{"ExpandDummyPolsAndSetMandelstam", "[", 
       RowBox[{
       "diagramWithDummyPols", ",", " ", "momenta", ",", " ", "helicities", 
        ",", " ", "masses", ",", "assumptions"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<[SimplifyDiagramWithDummyPols]: Summing contributions to \
diagram.\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"summedDiagram", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{"elem", ",", " ", 
        RowBox[{"{", 
         RowBox[{"elem", ",", " ", "listOfContributionsToDiagram"}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Put", " ", "in", " ", "RootExpand", " ", "modification", " ", 
       RowBox[{"here", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rootExpandedDiagram", "=", 
      RowBox[{"SplitSingleRoot", "[", 
       RowBox[{"summedDiagram", ",", " ", "assumptions"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<[SimplifyDiagramWithDummyPols]:  Starting simplification of sum of \
all diagrams\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"simplifiedResult", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{"rootExpandedDiagram", ",", " ", 
        RowBox[{"Assumptions", "\[Rule]", " ", "assumptions"}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", "simplifiedResult"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
