Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{
    RowBox[{
     RowBox[{"\<\"Using Assumptions:\"\>", "\[InvisibleSpace]", "t"}], 
     "\[Element]", 
     TemplateBox[{},
      "Reals"]}], "\[And]", 
    RowBox[{"mFP", ">", "0"}], "\[And]", 
    RowBox[{"s", ">", 
     SuperscriptBox["mFP", "2"]}], "\[And]", 
    RowBox[{"s", ">", 
     RowBox[{"4", " ", 
      SuperscriptBox["mFP", "2"]}]}], "\[And]", 
    RowBox[{
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["mFP", "6"], "-", 
        RowBox[{"3", " ", "s", " ", "t", " ", 
         SuperscriptBox["mFP", "2"]}], "+", 
        RowBox[{"s", " ", "t", " ", 
         RowBox[{"(", 
          RowBox[{"s", "+", "t"}], ")"}]}]}], ")"}]}], "<", "0"}]}],
   SequenceForm["Using Assumptions:", 
    And[
     Element[$CellContext`t, Reals], $CellContext`mFP > 
     0, $CellContext`s > $CellContext`mFP^2, $CellContext`s > 
     4 $CellContext`mFP^2, $CellContext`s ($CellContext`mFP^6 - 
       3 $CellContext`mFP^2 $CellContext`s $CellContext`t + $CellContext`s \
$CellContext`t ($CellContext`s + $CellContext`t)) < 0]],
   Editable->False], TraditionalForm]], "Print",
