          RowBox[{"A", "*", "B", "*", "C", "*", "D", "*"}], "..."}], 
         "]"}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "A", "]"}], "*", 
