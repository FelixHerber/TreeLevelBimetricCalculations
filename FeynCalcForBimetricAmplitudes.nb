Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Takes", " ", "the", " ", "masses", " ", "of", " ", "the", " ", "four", 
    " ", "particles", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m1", ",", " ", "m2", ",", " ", "m3", ",", " ", "m4"}], "}"}], 
     "."}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Gives", " ", "out", " ", "boolean", " ", "expressions", " ", "stating", 
