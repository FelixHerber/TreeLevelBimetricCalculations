   RowBox[{
   "amplitudeWithDummyPols_", ",", " ", "momenta_", ",", " ", "helicities_", 
    ",", " ", "masses_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "simplifiedDiagrams", ",", " ", "summedDiagrams", ",", "assumptions", 
      ",", " ", "amplitudeSimplify", ",", " ", "totMassSquared", ",", " ", 
      "amplitudeTrickMandelstam"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"simplifiedDiagrams", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"currentDiagram", ",", " ", 
          RowBox[{"SimplifyDiagramWithDummyPols", "[", 
           RowBox[{
           "currentDiagram", ",", " ", "momenta", ",", " ", "helicities", ",",
             " ", "masses"}], "]"}]}], "]"}], ",", "amplitudeWithDummyPols"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"summedDiagrams", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"simplifiedDiagrams", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
