     " ", "such", " ", "as", " ", "mi"}], " ", ">", " ", "0"}], ";", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
       "if", " ", "mi", " ", "is", " ", "NOT", " ", "zero", " ", "for", " ", 
        "that", " ", "i"}], " ", "=", " ", "1"}], ",", " ", "2", ",", " ", 
      "3", ",", " ", "4"}], ")"}], " ", "and", " ", "the", " ", "Mandelstam", 
