Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Takes", " ", "a", " ", "diagram", " ", "where", " ", "the", " ", 
    "Polarization", " ", "tensor", " ", "has", " ", "been", " ", "replaced", 
    " ", "by", " ", "dummy", " ", "polarizations", " ", "P1A"}], ",", " ", 
   "P1B", ",", " ", 
   RowBox[{
    RowBox[{"etc", ".."}], " ", "together", " ", "with", " ", "the", " ", 
    "momenta", " ", "of", " ", "the", " ", "particles"}], ",", " ", 
