      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"C", "*", "D", "*"}], "..."}], "."}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "Input", ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rootArg", " ", "-", " ", 
     RowBox[{"the", " ", "argument", " ", "inside", " ", "some", " ", 
      RowBox[{"rootpower", ".", " ", 
       RowBox[{"Ex", ":", " ", 
        RowBox[{"x", " ", "in", " ", 
