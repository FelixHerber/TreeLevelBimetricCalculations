Cell[BoxData[
 RowBox[{
  RowBox[{"ExpandDummyPolsAndSetMandelstam", "[", 
   RowBox[{
   "diagramWithDummyPols_", ",", " ", "momenta_", ",", " ", "helicities_", 
    ",", " ", "masses_", ",", " ", "assumptions_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "signedMomenta", ",", "diagramInsertPolTensors", ",", "diagramSetKin", 
      ",", " ", "totMassSquared", ",", "diagramSplitRoots", ",", " ", 
      "diagramSimplified"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Must", " ", "be", " ", "used", " ", "since", " ", "the", " ", "last", 
      " ", "two", " ", "particles", " ", "should", " ", "be", " ", 
      "outgoing"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"signedMomenta", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"momenta", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"momenta", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"momenta", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"momenta", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"totMassSquared", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"j", "^", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "masses"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<[FromDummyPolarizationsToMandelstam]: Fixing Polarization \
Tensors\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"diagramInsertPolTensors", "=", 
      RowBox[{"InsertPolarizationTensor", "[", 
       RowBox[{
       "diagramWithDummyPols", ",", " ", "signedMomenta", ",", "helicities"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<[FromDummyPolarizationsToMandelstam]: Setting Kinematics\>\"", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"diagramSetKin", "=", 
      RowBox[{"SetKinematics", "[", 
       RowBox[{"diagramInsertPolTensors", ",", "masses", ",", "momenta"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<[FromDummyPolarizationsToMandelstam]: Simplifying Each Diagram. \>\
\"", "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"diagramSplitRoots", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", " ", 
          RowBox[{"SplitSingleRoot", "[", 
           RowBox[{"x", ",", " ", "assumptions"}], "]"}]}], "]"}], ",", " ", 
        "diagramSetKin"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diagramSimplified", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"x", ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"x", "/.", 
             RowBox[{"{", 
              RowBox[{"u", "\[Rule]", " ", 
               RowBox[{
                RowBox[{"-", "s"}], "-", "t", "+", "totMassSquared"}]}], 
              "}"}]}], ",", " ", 
            RowBox[{"Assumptions", "\[Rule]", " ", "assumptions"}]}], "]"}]}],
          "]"}], ",", "diagramSplitRoots"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "diagramSimplified"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
