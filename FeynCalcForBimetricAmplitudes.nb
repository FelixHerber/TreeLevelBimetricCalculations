      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"SplitSingleRoot", "[", 
         RowBox[{"summedDiagrams", ",", " ", "assumptions"}], "]"}], ",", " ", 
        RowBox[{"Assumptions", "\[Rule]", "assumptions"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"totMassSquared", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"j", "^", "2"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "masses"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"amplitudeTrickMandelstam", "=", 
      RowBox[{"TrickMandelstam", "[", 
       RowBox[{
