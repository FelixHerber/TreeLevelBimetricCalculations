     "real"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", "Output", 
   ";", "\[IndentingNewLine]", 
   RowBox[{"splitFractionRoot", " ", "-", " ", 
    RowBox[{
    "the", " ", "expression", " ", "where", " ", "all", " ", "real", " ", 
     "arguments", " ", "have", " ", "been", " ", "dragged", " ", "out", " ", 
     "and", " ", "put", " ", "inside", " ", "a", " ", "distinct", " ", "root",
      " ", "to", " ", "the", " ", "power", " ", "of"}]}], ";", 
   "\[IndentingNewLine]", "                    ", 
   RowBox[{"rootPower", "."}]}], "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.9589157647496185`*^9, 3.9589157722725124`*^9}, {
