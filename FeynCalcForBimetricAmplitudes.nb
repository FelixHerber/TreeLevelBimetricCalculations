Cell[CellGroupData[{

Cell["Raw Feynman Diagram Generation", "Section",
 CellChangeTimes->{{3.9639868603897996`*^9, 
  3.9639868981030197`*^9}},ExpressionUUID->"0ab1318f-b19a-430d-9c3f-\
89268d6f99f8"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "Replaces", " ", "all", " ", "instances", " ", "of", " ", 
    "FAPropagatorNumerator", " ", "in", " ", "amplitude", " ", "with", " ", 
    "the", " ", "required", " ", "expression", " ", "namely", " ", "either"}],
    ";", " ", 
   RowBox[{
    RowBox[{"the", " ", "massless", " ", "or", " ", "massive", " ", "spin"}], 
    "-", 
    RowBox[{"2", " ", "propagator"}]}], ";", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "Input", ";", "\[IndentingNewLine]", 
   RowBox[{"amplitude", " ", "-", " ", 
    RowBox[{
    "any", " ", "expression", " ", "which", " ", "contains", " ", "the", " ", 
     "function", " ", "FAPropagatorNumerator"}]}], ";", "\[IndentingNewLine]",
    "Output", ";", "\[IndentingNewLine]", 
   RowBox[{"amplitude", " ", "-", " ", 
    RowBox[{
    "the", " ", "same", " ", "expression", " ", "but", " ", "were", " ", 
     "the", " ", "function", " ", "FAPropagatorNumerator", " ", "has", " ", 
     "been", " ", "swapped", " ", "for", " ", "its", " ", "explicit", " ", 
     "expression"}]}], ";"}], "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.959050591113064*^9, 3.9590506429989824`*^9}, 
   3.959596716536766*^9, {3.9595977889408064`*^9, 3.959597872662841*^9}, {
   3.9603477804077816`*^9, 3.9603477903186235`*^9}, {3.963967929850337*^9, 
   3.9639679439084883`*^9}, {3.964000465018539*^9, 
   3.9640004702813644`*^9}},ExpressionUUID->"b4da1334-e7a7-4664-a032-\
5984e9657821"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetFAPropagatorNumerator", "[", "amplitude_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"G", ",", " ", "FAPropagatorNumerator"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "[", 
       RowBox[{"inds1_", ",", "inds2_", ",", " ", "mom_", ",", "x_"}], "]"}], 
      ":=", 
      RowBox[{
       RowBox[{"MetricTensor", "[", 
        RowBox[{"inds1", ",", "inds2"}], "]"}], "-", 
       RowBox[{
        RowBox[{"FV", "[", 
         RowBox[{"mom", ",", "inds1"}], "]"}], 
        RowBox[{
         RowBox[{"FV", "[", 
          RowBox[{"mom", ",", "inds2"}], "]"}], "/", 
         RowBox[{"x", "^", "2"}]}]}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"FAPropagatorNumerator", "[", 
       RowBox[{
       "li1p1_", ",", "li1p2_", ",", "li2p1_", ",", "li2p2_", ",", " ", 
        "mom_", ",", "x_"}], "]"}], ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
