Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rootFactor", "[", 
    RowBox[{"rootArg_", ",", "rootPower_", ",", " ", "assumptions_"}], "]"}], 
   ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "argInRootFactor", ",", "argInRootFactorInList", ",", "positiveFactors",
        ",", " ", "negativeFactors", ",", " ", "otherFactors", ",", 
       "splitFactorRoot", ",", " ", "splitPositiveFactors", ",", 
       "splitNegativeFactors", ",", "splitOtherFactors", ",", 
       "multiplyPosFactors", ",", "multiplyNegFactors", ",", " ", 
       "multiplyOtherFactors"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"argInRootFactor", "=", 
       RowBox[{"Factor", "[", "rootArg", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "argInRootFactor", "]"}], "===", " ", "Times"}],
         ",", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Put", " ", "Each", " ", "Factor", " ", "in", " ", "a", " ", 
          "List"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"argInRootFactorInList", " ", "=", " ", 
          RowBox[{"List", "@@", "argInRootFactor"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "positiveFactors", ",", " ", "negativeFactors", ",", " ", 
            "otherFactors"}], "}"}], "=", 
          RowBox[{"SplitRealsFromList", "[", 
           RowBox[{"argInRootFactorInList", ",", " ", "assumptions"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"splitPositiveFactors", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"x", ",", " ", 
              RowBox[{"Power", "[", 
               RowBox[{"x", ",", " ", 
                RowBox[{"Rational", "[", 
                 RowBox[{"rootPower", ",", " ", "2"}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", "positiveFactors"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"splitNegativeFactors", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"x", ",", " ", 
              RowBox[{"Power", "[", 
               RowBox[{
                RowBox[{"-", "x"}], ",", " ", 
                RowBox[{"Rational", "[", 
                 RowBox[{"rootPower", ",", " ", "2"}], "]"}]}], "]"}]}], 
             "]"}], ",", " ", "negativeFactors"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"splitOtherFactors", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"Length", "[", "negativeFactors", "]"}], ")"}]}], 
             "}"}], ",", " ", "otherFactors"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"multiplyPosFactors", "=", 
          RowBox[{"Apply", "[", 
           RowBox[{"Times", ",", " ", "splitPositiveFactors"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"multiplyNegFactors", "=", 
          RowBox[{"Apply", "[", 
           RowBox[{"Times", ",", " ", "splitNegativeFactors"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"multiplyOtherFactors", "=", 
          RowBox[{"Power", "[", 
           RowBox[{
            RowBox[{"Apply", "[", 
             RowBox[{"Times", ",", " ", "splitOtherFactors"}], "]"}], ",", 
            " ", 
            RowBox[{"Rational", "[", 
             RowBox[{"rootPower", ",", " ", "2"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"splitFactorRoot", "=", 
          RowBox[{"Times", "[", 
           RowBox[{
           "multiplyPosFactors", ",", "multiplyNegFactors", ",", " ", 
            "multiplyOtherFactors"}], "]"}]}], ";"}], ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"splitFactorRoot", "=", 
         RowBox[{"Power", "[", 
          RowBox[{"rootArg", ",", " ", 
           RowBox[{"Rational", "[", 
            RowBox[{"rootPower", ",", " ", "2"}], "]"}]}], "]"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", "splitFactorRoot"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
