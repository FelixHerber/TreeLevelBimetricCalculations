Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "amplitude", " ", "is", " ", "the", " ", "same", " ", "as", " ", 
    RowBox[{"eq", ".", " ", 
     RowBox[{"(", "8.5", ")"}]}], " ", "of", " ", "the", " ", 
    RowBox[{"Master", "'"}], "s", " ", "Thesis", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"F", ".", " ", "Herber"}], " ", 
       RowBox[{"(", "2025", ")"}]}], ")"}], "."}]}], "*)"}], 
  "\[IndentingNewLine]", "amplitudeGGMM"}]], "Input",
 CellChangeTimes->{{3.9912759397526417`*^9, 3.9912759433669147`*^9}, {
  3.9912797480424995`*^9, 3.991279794400522*^9}, {3.9914790928065014`*^9, 
  3.9914790932914886`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"6f909496-36f1-0c45-b337-efc68c9f204d"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"s", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["mFP", "4"]}], "+", 
      RowBox[{
       SuperscriptBox["s", 
        RowBox[{"3", "/", "2"}]], " ", 
       SqrtBox[
        RowBox[{"s", "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mFP", "2"]}]}]]}], "-", 
      RowBox[{"4", " ", 
       SuperscriptBox["mFP", "2"], " ", "s"}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["mFP", "2"], " ", 
       SqrtBox["s"], " ", 
       SqrtBox[
        RowBox[{"s", "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["mFP", "2"]}]}]]}], "+", 
      SuperscriptBox["s", "2"]}], ")"}]}], 
   RowBox[{"4", " ", 
    SuperscriptBox["mPl", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["mFP", "2"], "-", "t"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["mFP", "2"], "-", "u"}], ")"}]}]], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.9912759437349415`*^9, 3.9956187958924904`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"5d62f016-b118-fa42-9e69-678eafc33220"]
}, Open  ]],

