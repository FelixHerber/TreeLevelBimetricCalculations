Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "If", " ", "one", " ", "wants", " ", "to", " ", "compute", " ", "multiple",
     " ", "helicity", " ", "amplitudes", " ", "from", " ", "the", " ", "same",
     " ", "underlying", " ", "process"}], ",", " ", 
   RowBox[{
    RowBox[{"say", " ", "GG"}], " ", "->", " ", 
    RowBox[{
     RowBox[{"GG", " ", "and", " ", "GG"}], " ", "->", " ", "MM"}]}], ",", 
   " ", 
   RowBox[{
   "it", " ", "is", " ", "better", " ", "to", " ", "use", " ", 
    "Generate2To2AmpStructures", " ", "as", " ", "this", " ", "generates", " ",
     "a", " ", "dictionary", " ", "containing", " ", "the", " ", "FeynCalc", " ",
     "and", " ", "FeynAmp", " ", "amplitudes", " ", "for", " ", "the", " ", 
    "processes", " ", 
    RowBox[{"first", ".", " ", "Then"}]}], ",", " ", 
   RowBox[{
   "one", " ", "can", " ", "just", " ", "set", " ", "different", " ", 
    "helicity", " ", "configurations", " ", "on", " ", "it", " ", 
    RowBox[{"later", ".", " ", "Below"}]}], ",", " ", 
   RowBox[{
    RowBox[{
    "we", " ", "are", " ", "only", " ", "considering", " ", "the", " ", 
     "processes", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", "1"}], "}"}], " ", 
     "and", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1", ",", " ", "2", ",", " ", "2"}], "}"}], " ", 
     "which", " ", "correspond", " ", "to", " ", "GG"}], "->", " ", 
