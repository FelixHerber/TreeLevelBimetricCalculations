            RowBox[{
             RowBox[{"mf", "/", "mg"}], "*", 
             RowBox[{"\[Delta]M", "[", 
              RowBox[{"inds1", ",", "inds2"}], "]"}]}]}], ")"}]}]}], ",", " ", 
