Cell[TextData[{
 "We start from here and on by using x as the perturbation parameter instead \
of \[Epsilon].\nSince we will later use AutomaticRules to demand that only up \
to fourth order in x remains and  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "5"], TraditionalForm]],ExpressionUUID->
  "efe6f486-2c31-4cc3-a1cd-538ef91232f1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "6"], TraditionalForm]],ExpressionUUID->
  "faf54ecf-1399-4300-8150-4ecccc0833ce"],
 ", ... is removed."
}], "Text",
 CellChangeTimes->{{3.9566308818169117`*^9, 3.9566308887366853`*^9}, {
  3.959477163240223*^9, 3.9594771798745904`*^9}, {3.9594777743015337`*^9, 
