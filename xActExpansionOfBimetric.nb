c71f1e25cbcd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"secondPolynomial", "-", 
    RowBox[{
     RowBox[{"1", "/", "2"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Scalar", "[", "firstPolynomial", "]"}], "^", "2"}], " ", "-",
        " ", 
       RowBox[{"insideSquareRootFinal", "*", 
        RowBox[{"g", "[", 
         RowBox[{"\[Gamma]", ",", 
          RowBox[{"-", "\[Alpha]"}]}], "]"}]}]}], ")"}]}]}], "//", 
   "NoScalar"}], "//", "Simplification"}]], "Input",
 CellChangeTimes->{{3.956563306961403*^9, 3.956563313291439*^9}, {
   3.956628832243899*^9, 3.9566289003834763`*^9}, 3.9566289755343795`*^9},
