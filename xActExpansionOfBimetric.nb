Cell[CellGroupData[{

Cell["Check consistency of bimetric interaction:", "Section",
 CellChangeTimes->{{3.956630126718754*^9, 
  3.9566301317718563`*^9}},ExpressionUUID->"c9e4ca34-5097-426d-a45d-\
c8c1179cfbbf"],

Cell["\<\
Below, we will check that the bimetric interaction has the required symmetry \
in \[Beta]1 and \[Beta]3 in addition to \[Beta]0 and \[Beta]4.
More precisely, if we set c = 1 and \[Beta]0 = \[Beta]4 = \[Beta]2 = 0, the \
bimetric interaction piece should not change if we swap  \[Beta]1  with \
\[Beta]3 and at the same time \[Delta]g with \[Delta]f. Similarly, if we set \
c = 1 and \[Beta]1 = \[Beta]3 = \[Beta]2 = 0, the bimetric interaction piece \
should not change if we swap \[Beta]0 and \[Beta]4 and at the same time \
\[Delta]g with \[Delta]f.\
\>", "Text",
 CellChangeTimes->{{3.9594782637732964`*^9, 3.9594782865663414`*^9}, {
  3.9705558283789062`*^9, 
  3.9705559613014126`*^9}},ExpressionUUID->"bd98845b-9c92-43fd-b357-\
6d0eb327d99f"],

Cell["Check consistency for swapping \[Beta]1 and \[Beta]3:", "Text",
 CellChangeTimes->{{3.956582427514267*^9, 3.9565824396162577`*^9}, {
  3.956629921311996*^9, 
  3.956629928091716*^9}},ExpressionUUID->"8d1afb93-2cce-4bbd-a86a-\
e5dff48b3373"],

