             Offset[0.034999999999999996`]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}}],
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`f[-$CellContext`\[Beta], -$CellContext`\[Gamma]],
      Editable->False], "]"}],
    ShowAutoStyles->False,
    AutoSpacing->False],
   xAct`xPert`Perturbation[
    $CellContext`f[-$CellContext`\[Beta], -$CellContext`\[Gamma]]],
   Editable->False]],
