Cell[TextData[{
 "This code below sets the value of the S tensor to be the expansion ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     InterpretationBox[
      StyleBox["c",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`c,
      Editable->False], 
     SqrtBox[
      RowBox[{"1", "+", "\[CapitalXi]"}]]}], "\[TildeTilde]", 
    RowBox[{
     InterpretationBox[
      StyleBox["c",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`c,
      Editable->False], "(", 
     RowBox[{"1", "+", 
      RowBox[{
       FractionBox["1", "2"], "\[CapitalXi]"}], "-"}]}]}], TraditionalForm]],
  ExpressionUUID->"ccd5898f-2d9e-4461-aacb-ce763ba0cc00"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "8"], 
     SuperscriptBox["\[CapitalXi]", "2"]}], "+"}], TraditionalForm]],
  ExpressionUUID->"b0cec3bd-7379-42c3-8e46-09f90a32cb02"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", "16"], 
      SuperscriptBox["\[CapitalXi]", "3"]}], "-", 
     RowBox[{
      FractionBox["5", "128"], 
      SuperscriptBox["\[CapitalXi]", "4"]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"f1a24b2f-65dd-4e9f-bd8e-c4bdd25a9322"],
 ". with the tensor \[CapitalXi] substituted above. Due to the AutomaticRules \
above, it neglects order x^5 and above."
}], "Text",
 CellChangeTimes->{{3.9455008384515457`*^9, 3.9455008737665997`*^9}, {
  3.9455732306453333`*^9, 
  3.9455732610654907`*^9}},ExpressionUUID->"0826d6c4-36d7-4391-a9e0-\
fd0795c635ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"IndexSet", "[", 
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Alpha]_", ",", "\[Beta]_"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"c", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"g", "[", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"1", "/", "2"}], "*", 
             RowBox[{"X", "[", 
              RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}]}], "-", 
            RowBox[{
             RowBox[{"1", "/", "8"}], "*", 
             RowBox[{"X", "[", 
              RowBox[{"\[Alpha]", ",", 
               RowBox[{"-", "\[Theta]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Theta]", ",", "\[Beta]"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"1", "/", "16"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Alpha]", ",", 
               RowBox[{"-", "\[Theta]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Theta]", ",", 
               RowBox[{"-", "\[Phi]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Phi]", ",", "\[Beta]"}], "]"}]}], "-", 
            RowBox[{
             RowBox[{"5", "/", "128"}], "*", 
             RowBox[{"X", "[", 
              RowBox[{"\[Alpha]", ",", 
               RowBox[{"-", "\[Theta]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Theta]", ",", 
               RowBox[{"-", "\[Phi]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Phi]", ",", 
               RowBox[{"-", "\[Omicron]"}]}], "]"}], 
             RowBox[{"X", "[", 
              RowBox[{"\[Omicron]", ",", "\[Beta]"}], "]"}]}]}], ")"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"inds3_", ",", " ", "inds4_"}], "]"}], "\[Rule]", " ", 
            RowBox[{"x", "*", 
             RowBox[{"h", "[", 
              RowBox[{"inds3", ",", "inds4"}], "]"}]}]}], ",", " ", 
           RowBox[{
            RowBox[{"\[Delta]f", "[", 
             RowBox[{"inds5_", ",", "inds6_"}], "]"}], "\[Rule]", " ", 
            RowBox[{"x", "*", 
             RowBox[{"\[Delta]f", "[", 
              RowBox[{"inds5", ",", "inds6"}], "]"}]}]}]}], "}"}]}], "//", 
        "Simplification"}], "//", "ContractMetric"}], ",", "x"}], "]"}]}], 
   " ", "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.945491138385334*^9, 3.945491214695036*^9}, {
   3.945493777063272*^9, 3.945493833237892*^9}, 3.945493892071273*^9, {
   3.945500523223909*^9, 3.94550054009363*^9}, {3.945500584337961*^9, 
   3.9455006390111675`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"ffdb6a6b-a992-4f47-b4e3-ebf51616135c"],

Cell["\<\
Do a consistency check, is this the square root of the expression we took the \
square root of?\
\>", "Text",
 CellChangeTimes->{{3.9566310070019703`*^9, 
  3.9566310235812693`*^9}},ExpressionUUID->"9486b2a9-41ba-4ee4-85c1-\
07364ca8f4ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"squaredS", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Alpha]", ",", 
      RowBox[{"-", "\[Beta]"}]}], "]"}], 
    RowBox[{"S", "[", 
     RowBox[{"\[Beta]", ",", 
      RowBox[{"-", "\[Gamma]"}]}], "]"}]}], "//", 
   "Simplification"}]}]], "Input",
 CellChangeTimes->{{3.956562303023191*^9, 3.9565623421195393`*^9}, {
  3.95656237869038*^9, 3.956562382291701*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"f96b59a5-8022-4404-aa2c-f9e516fae6e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox[
    InterpretationBox[
     StyleBox["c",
      ShowAutoStyles->False,
      AutoSpacing->False],
     $CellContext`c,
     Editable->False], "2"], " ", 
   InterpretationBox[
    StyleBox[GridBox[{
       {"\[Delta]", 
        StyleBox[GridBox[{
           {"\[Alpha]", " "},
           {" ", "\[Gamma]"}
          },
          GridBoxSpacings->{"Columns" -> {
              Offset[0.], {
               Offset[0.034999999999999996`]}, 
              Offset[0.]}, "Rows" -> {{
               Offset[0.]}}}],
         FontSize->Rational[39, 4]]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Center}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.034999999999999996`]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
