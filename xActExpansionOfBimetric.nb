Notebook[{

Cell[CellGroupData[{
Cell["Bimetric Theory Expansion", "Title",
 CellChangeTimes->{{3.9566281333675404`*^9, 3.9566281357079926`*^9}, {
  3.956630080029989*^9, 
  3.956630082963414*^9}},ExpressionUUID->"a2676191-4f6b-47e1-9512-\
e2432b712e83"],

Cell[TextData[{
 "This notebook generates the bimetric-theory Lagrangian used to construct \
the FeynRules/FeynArts model file. It is intended as a reproducibility \
notebook rather than a general-purpose package. The generated model file used \
in the amplitude calculations is included separately.\n\nBelow, we will \
expand the action of bimetric theory about perturbations ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "b390bdd0-75d5-46ae-ae13-c88800c367c4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "fac27fb0-c94c-462b-a566-18673b7bbe6f"],
 " or by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     SubscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
     SubscriptBox["\[Delta]g", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"635db44a-eeae-4a1e-b5d0-b3c6352fdeff"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["c", "2"], 
      SubscriptBox["\[Eta]", "\[Mu]\[Nu]"]}], "+", 
     SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"107e837f-3dae-46f9-82bb-afcc37daaf08"],
 "."
}], "Text",
 CellChangeTimes->{{3.959475908194832*^9, 3.95947591107788*^9}, {
  3.9594759756166973`*^9, 3.9594761266236796`*^9}, {3.959476232067833*^9, 
  3.9594762438823385`*^9}, {3.959476298317288*^9, 3.9594763015601635`*^9}, {
  3.9912254995584126`*^9, 
  3.991225507086939*^9}},ExpressionUUID->"506f3311-3cde-449b-bc2c-\
16761e7f01e7"],

Cell[CellGroupData[{

Cell["The Bimetric Interaction", "Chapter",
 CellChangeTimes->{{3.9566300907541556`*^9, 
  3.956630099100276*^9}},ExpressionUUID->"d430e233-d4d1-4ed6-80a2-\
81456b348b8c"],

Cell["\<\
First, we start by expanding the interaction of bimetric theory.\
\>", "Text",
 CellChangeTimes->{
  3.9594763058637133`*^9},ExpressionUUID->"b13963c6-0b0a-4ec6-a443-\
0371b17212a6"],

Cell[CellGroupData[{

Cell["Constructing the Symmetric Polynomials", "Section",
 CellChangeTimes->{{3.956405249227687*^9, 3.9564052499588647`*^9}, {
  3.9565794057379513`*^9, 3.956579406428166*^9}, {3.95662915121483*^9, 
  3.956629157537036*^9}, {3.956629766338209*^9, 
  3.9566297833397937`*^9}},ExpressionUUID->"e7550a8a-eb0b-450b-80f9-\
2c6c66166fbb"],

Cell["\<\
Must be here to avoid errors with Mathematica 14.3. For xAct`xPerm`  version \
1.2,  xAct`xTensor`  version 1.2.0, xAct`xPert`  version 1.0.6, xAct`xPerm` \
version 1.2.3, xAct`TexAct`  version 0.4.3 and xAct`xCoba version 0.8.6.\
\>", "Text",
 CellChangeTimes->{{3.9705544595409107`*^9, 3.9705544675480328`*^9}, {
  3.9914799071428185`*^9, 
  3.9914800416548424`*^9}},ExpressionUUID->"a1a4ab53-38c9-9a4f-828f-\
becf44b263d5"],

Cell[BoxData[{
 RowBox[{"xAct`xTensor`Commutator", ";"}], "\n", 
 RowBox[{"xAct`xTensor`Anticommutator", ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"0560ba7e-abcd-ad4f-9976-cdca09425f3e"],

Cell[TextData[{
 "The metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "92883cbd-4ccd-4fa3-9b4e-e1b80bffe577"],
 " and its perturbation."
}], "Text",
 CellChangeTimes->{{3.9594765928464375`*^9, 
  3.959476608046468*^9}},ExpressionUUID->"d258f1d2-3d30-4f6b-84e3-\
