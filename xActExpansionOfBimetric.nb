 CellLabel->"In[25]:=",ExpressionUUID->"cff7a19e-1e05-4ed3-a31b-69da026e2ad6"],

Cell[TextData[{
 "Set higher order perturbations of f and  g than 1 to zero and set the \
background metric of f to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["f", "_"], "\[Mu]\[Nu]"], "=", 
    RowBox[{
     SuperscriptBox[
      InterpretationBox[
       StyleBox["c",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`c,
       Editable->False], "2"], 
     SubscriptBox[
      RowBox[{
       OverscriptBox["g", "_"], " "}], "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"40b38e0b-1eaa-40df-8791-414f7e2368c8"],
 ". \nTo do that, we only need to replace each occurrence of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["f", "_"], "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "b0d19e54-e51f-4202-90a7-f87d26f7160c"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     InterpretationBox[
      StyleBox["c",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`c,
      Editable->False], "2"], 
    SubscriptBox[
     RowBox[{
      OverscriptBox["g", "_"], " "}], "\[Mu]\[Nu]"]}], TraditionalForm]],
  ExpressionUUID->"6a4b28ec-cf47-4502-9717-d27d1167b2af"],
 " since in the expression above, the indices are lowered on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "\[Rho]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "52ff0548-274d-4b70-b5a4-a0b5cba41c56"],
 ".\nLastly, rename ",
 Cell[BoxData[
  InterpretationBox[
   StyleBox[
    RowBox[{"\[EmptyUpTriangle]", "[", 
     InterpretationBox[
      StyleBox[GridBox[{
         {"f", 
