Cell[BoxData[
 RowBox[{"insideSquareRoot2", "=", 
  RowBox[{
   RowBox[{"insideSquareRoot", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Perturbation", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"inds1_", ",", "inds2_"}], "]"}], ",", " ", "1"}], "]"}], 
       "\[Rule]", " ", 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1", ",", "inds2"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Perturbation", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"inds1_", ",", "inds2_"}], "]"}], ",", " ", "2"}], "]"}], 
       "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"Perturbation", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"inds1_", ",", "inds2_"}], "]"}], ",", " ", "3"}], "]"}], 
       "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"Perturbation", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"inds1_", ",", "inds2_"}], "]"}], ",", " ", "4"}], "]"}], 
       "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]g", "[", 
        RowBox[{
         RowBox[{"LI", "[", "1", "]"}], ",", "inds1_", ",", "inds2_"}], "]"}],
        "\[Rule]", " ", 
       RowBox[{"h", "[", 
        RowBox[{"inds1", ",", " ", "inds2"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]g", "[", " ", 
        RowBox[{
         RowBox[{"LI", "[", "2", "]"}], ",", "inds1_", ",", "inds2_"}], "]"}],
        "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]g", "[", " ", 
        RowBox[{
         RowBox[{"LI", "[", "3", "]"}], ",", "inds1_", ",", "inds2_"}], "]"}],
        "\[Rule]", "0"}], ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]g", "[", " ", 
        RowBox[{
         RowBox[{"LI", "[", "4", "]"}], ",", "inds1_", ",", "inds2_"}], "]"}],
        "\[Rule]", " ", "0"}], ",", " ", 
      RowBox[{"\[Epsilon]", "\[Rule]", " ", "1"}], ",", " ", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"inds1_", ",", " ", "inds2_"}], "]"}], "\[Rule]", " ", 
       RowBox[{
        RowBox[{"c", "^", "2"}], "*", 
        RowBox[{"g", "[", 
         RowBox[{"inds1", ",", "inds2"}], "]"}]}]}]}], "}"}]}], "//", 
   "ContractMetric"}]}]], "Input",
 CellChangeTimes->{{3.9454405036885695`*^9, 3.9454406835320034`*^9}, {
