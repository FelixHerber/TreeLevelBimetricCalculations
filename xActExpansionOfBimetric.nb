Cell[TextData[{
 "Explanation: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"-", "f"}]], 
     RowBox[{"R", "(", "f", ")"}]}], "="}], TraditionalForm]],ExpressionUUID->
  "e1d8562b-8ba6-4e29-afc3-285dec1eb303"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"det", "(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["c", "2"], 
          SubscriptBox["\[Eta]", "\[Mu]\[Nu]"]}], "+", 
         SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}], ")"}]}]], 
     RowBox[{"R", "(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["c", "2"], 
        SubscriptBox["\[Eta]", "\[Mu]\[Nu]"]}], "+", 
       SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}], ")"}]}], " ", "=", 
    RowBox[{
     SuperscriptBox["c", "4"], 
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"det", "(", 
        RowBox[{
         SubscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
         FractionBox[
          SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"], 
          SuperscriptBox["c", "2"]]}], ")"}]}]], 
     RowBox[{"R", "(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["c", "2"], 
        SubscriptBox["\[Eta]", "\[Mu]\[Nu]"]}], "+", 
       SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}], ")"}], " "}]}], 
   TraditionalForm]],ExpressionUUID->"3a248a26-160a-429d-8c0c-64bf894f7a71"],
 "so we get an extra ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", "4"], TraditionalForm]],ExpressionUUID->
  "1323fd8e-04c9-4d18-8d0f-e5953b9fe6cf"],
 " in front.\nNote that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"R", "(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["c", "2"], 
       SubscriptBox["\[Eta]", "\[Mu]\[Nu]"]}], "+", 
      SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}], ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox["c", "2"]], 
     RowBox[{"R", "(", 
      RowBox[{
       SubscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
       FractionBox[
        SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"], 
        SuperscriptBox["c", "2"]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"cb8b1103-49a1-4f34-95f8-a98ef023cc0b"],
 " so in total ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "f"}]], 
    RowBox[{"R", "(", "f", ")"}]}], TraditionalForm]],ExpressionUUID->
  "39a578b5-db7c-4991-9b4c-9f816a0a3333"],
 "=",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["c", "2"], 
   SqrtBox[
    RowBox[{
     RowBox[{"-", "det"}], 
     RowBox[{"(", 
      RowBox[{
       FormBox[
        SubscriptBox["\[Eta]", "\[Mu]\[Nu]"],
        TraditionalForm], "+", 
       FractionBox[
        FormBox[
         SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"],
         TraditionalForm], 
        SuperscriptBox["c", "2"]]}], ")"}]}]]}]],ExpressionUUID->
  "28d17cfb-7e75-4cbf-8203-319556268fff"],
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "(", 
    RowBox[{
     SubscriptBox["\[Eta]", "\[Mu]\[Nu]"], "+", 
     FractionBox[
      SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"], 
      SuperscriptBox["c", "2"]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "20ff19ab-2618-4bc7-ac87-17fc3c90bb32"],
 ". \nHence for each order in \[Delta]f we get a ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["c", "2"]], TraditionalForm]],ExpressionUUID->
  "9303a17b-cc4a-4069-ae40-debec3acdaea"],
 " for each \[Delta]g together with a net c^2 in front of it the whole \
expression. "
}], "Text",
 CellChangeTimes->{{3.956632474656407*^9, 3.956632550105426*^9}, {
  3.956632598611077*^9, 3.9566327008171234`*^9}, {3.95663273810284*^9, 
  3.9566327737225924`*^9}, {3.956632822915814*^9, 3.9566328467872257`*^9}, {
  3.956632920099183*^9, 3.956632987592478*^9}, {3.9594808566372914`*^9, 
  3.9594808593811493`*^9}, {3.9594810998185153`*^9, 3.959481180477968*^9}, {
  3.959481219808364*^9, 
  3.959481274999468*^9}},ExpressionUUID->"9911a021-6469-4ca5-9561-\
6b0f5d6a6dd9"],

