Cell[TextData[{
 "Below, we get the other interactions using the symmetry: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"-", "g"}]], 
     RowBox[{
      SubscriptBox["e", "k"], "(", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["g", 
         RowBox[{"-", "1"}]], "f"}]], ")"}]}], " ", "=", " ", 
    RowBox[{
     SqrtBox[
      RowBox[{"-", "f"}]], 
     RowBox[{
      SubscriptBox["e", 
       RowBox[{"4", "-", "k"}]], "(", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["f", 
         RowBox[{"-", "1"}]], "g"}]], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"47146dd4-67af-40f5-a899-b3ff1bc84cb9"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "0"}], ",", "1."}], TraditionalForm]],ExpressionUUID->
  "70fdbc67-420d-4a91-bec2-13ba759633da"],
 " "
}], "Text",
 CellChangeTimes->{{3.956580829821109*^9, 3.956580866905227*^9}, {
  3.956629264549402*^9, 
  3.9566293496973066`*^9}},ExpressionUUID->"b1cdbfc6-4b24-4e0d-ab35-\
811f3ef4b22a"],

