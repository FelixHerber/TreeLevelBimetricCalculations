Cell[TextData[{
 "Below, we shall use the variables  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "Pl"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["c", "2"], "*", 
      SubsuperscriptBox["m", "f", "2"]}], " ", "+", 
     SubsuperscriptBox["m", "g", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "65daae4a-d1bb-4f53-be21-c5ca6a90a9fe"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", 
    FractionBox[
     RowBox[{"c", "*", 
      SubscriptBox["m", "f"]}], 
     SubscriptBox["m", "g"]]}], TraditionalForm]],ExpressionUUID->
  "a6f7fe07-3d28-430a-b834-ae494dd3ce42"],
 " giving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "f"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["m", "Pl"], "c"], "*", 
     FractionBox["q", 
      SqrtBox[
       RowBox[{"1", "+", 
        SuperscriptBox["q", "2"]}]]]}]}], TraditionalForm]],ExpressionUUID->
  "51719ae7-e56f-45bb-bc42-f54dec9f51c7"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["m", "f"], "=", 
    FractionBox[
     SubscriptBox["m", "Pl"], 
     SqrtBox[
      RowBox[{"1", "+", 
       SuperscriptBox["q", "2"]}]]]}], TraditionalForm]],ExpressionUUID->
  "a8f08a82-bb46-44e7-8a47-30264885b09e"],
 " to rewrite the result."
}], "Text",
