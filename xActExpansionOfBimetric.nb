Cell[BoxData[
 RowBox[{
  RowBox[{"quarticPartSimplification", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"quarticPart", " ", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"inds1_", ",", "inds2_"}], "]"}], "\[Rule]", 
         RowBox[{
          RowBox[{"c", "/", 
           RowBox[{"(", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"mg", "^", "2"}], "+", 
              RowBox[{
