Cell[TextData[{
 "Check consistency of secondInteraction. \nNamely that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SqrtBox[
     RowBox[{"-", "g"}]], 
    SubscriptBox["e", "2"], 
    RowBox[{"(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["g", 
        RowBox[{"-", "1"}]], "f"}]], ")"}]}], " ", "=", 
   FormBox[
    RowBox[{
     SqrtBox[
      RowBox[{"-", "f"}]], 
     SubscriptBox["e", "2"], 
     RowBox[{"(", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["f", 
         RowBox[{"-", "1"}]], "g"}]], ")"}]}],
    TraditionalForm]}]],ExpressionUUID->
  "d094b915-9577-4e76-8f52-7bce4786ff0e"],
 "holds.\nStart by constructing ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "f"}]], 
    SubscriptBox["e", "2"], 
    RowBox[{"(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["f", 
        RowBox[{"-", "1"}]], "g"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"43a0737b-4620-4ee4-87c6-6a674da04e03"],
 ".\n\nNote that in general, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "f"}]], 
    SubscriptBox["e", "k"], 
    RowBox[{"(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["f", 
        RowBox[{"-", "1"}]], "g"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"af2f4080-89c5-4ccc-9442-f89453bedd3c"],
 " can be constructed from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "g"}]], 
    SubscriptBox["e", 
     RowBox[{"4", "-", "k"}]], 
    RowBox[{"(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["g", 
        RowBox[{"-", "1"}]], "f"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"2531f7f1-b146-48b8-b44c-0f7184fe03a8"],
 " through the following:\n\nFirst take  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "\[Rule]", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "35704f4e-673d-4ef9-b5c5-e5893100c73c"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "g"}]], 
    RowBox[{
     SubscriptBox["e", 
      RowBox[{"4", "-", "k"}]], "(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["g", 
        RowBox[{"-", "1"}]], "f"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"69b4f2fb-3831-4aaf-aa1d-53c49e639676"],
 " . \nSecond, do the swapping  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]g", "\[Rule]", " ", 
    FractionBox["\[Delta]f", 
     SuperscriptBox["c", "2"]]}], TraditionalForm]],ExpressionUUID->
  "216e7b36-3dfe-432f-b863-cfc829d776a8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]f", "\[Rule]", " ", "\[Delta]g"}], TraditionalForm]],
  ExpressionUUID->"939bc675-3aa7-441b-8d75-762b5e80146e"],
 ". \nThirdly, multiply the end result by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["c", 
    RowBox[{"4", "-", "k"}]], TraditionalForm]],ExpressionUUID->
  "575fbddf-d8f7-464e-9a13-91a42400758c"],
 ". \nThen you have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"-", "f"}]], 
    SubscriptBox["e", "k"], 
    RowBox[{"(", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["f", 
        RowBox[{"-", "1"}]], "g"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"037dacba-8574-437c-bfe2-bc302046f4dc"],
 " "
}], "Text",
 CellChangeTimes->{{3.956580579072959*^9, 3.9565805872940445`*^9}, {
  3.956629366381074*^9, 3.9566295982328568`*^9}, {3.956629649173259*^9, 
  3.956629649462263*^9}, {3.959478027736294*^9, 
  3.959478140804178*^9}},ExpressionUUID->"19b255c3-71e0-48eb-a23d-\
5e4924d3ee0e"],

