Cell[BoxData[
 RowBox[{
  RowBox[{"insideSquareRoot", "=", 
   RowBox[{
    RowBox[{"Perturbed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"\[Alpha]", ",", "\[Beta]"}], "]"}], 
       RowBox[{"f", "[", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], ",", 
         RowBox[{"-", "\[Gamma]"}]}], "]"}]}], ",", "4"}], "]"}], "//", 
    "ExpandPerturbation"}]}], ";"}]], "Input",
