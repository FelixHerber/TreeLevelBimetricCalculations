Cell[BoxData[
 RowBox[{
  RowBox[{
  "ReplaceDoubleCovariantDerivativesOnExpandedExpression", "[", "expr_", 
   "]"}], ":=", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Times", "[", 
      RowBox[{"x_", ",", 
       RowBox[{
        RowBox[{"CD", "[", "inds1__", "]"}], "@", 
        RowBox[{
         RowBox[{"CD", "[", "inds2__", "]"}], "@", "z_"}]}]}], "]"}], 
     "\[RuleDelayed]", 
     RowBox[{
      RowBox[{
       RowBox[{"TotDer", "[", "inds1", "]"}], "@", 
       RowBox[{"(", 
        RowBox[{"Times", "[", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{"CD", "[", "inds2", "]"}], "@", "z"}]}], "]"}], ")"}]}], 
      "-", 
      RowBox[{"Times", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", "inds1", "]"}], "@", "x"}], ",", 
        RowBox[{
         RowBox[{"CD", "[", "inds2", "]"}], "@", "z"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9379699101633816`*^9, 3.9379699391972485`*^9}, {
  3.9379703610304284`*^9, 3.937970361063445*^9}, {3.9379719993676405`*^9, 
  3.937972027032523*^9}, {3.9465181663764257`*^9, 3.946518167108513*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"6d93372a-24a3-49a7-a50c-582fc814b377"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ReplaceDoubleCovariantDerivatives", "[", "expr_", "]"}], ":=", " ", 
  RowBox[{"ReplaceDoubleCovariantDerivativesOnExpandedExpression", "[", 
   RowBox[{"Expand", "[", "expr", "]"}], "]"}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"a62c9977-909a-427e-be54-07d482370465"],

Cell["\<\
