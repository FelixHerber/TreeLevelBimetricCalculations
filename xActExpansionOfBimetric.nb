Cell["\<\
Pick out all occurances of functions which are not the elementary ones or the \
derivative, del.
The only thing this code should pickout is hence the function M[x,y] and \
G[x,y] and so on.\
\>", "Text",
 CellChangeTimes->{{3.9595122517839265`*^9, 
  3.959512298809083*^9}},ExpressionUUID->"3390e584-5483-4373-90fa-\
19592495176b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"listOfFunctions", "=", 
   RowBox[{"Cases", "[", 
    RowBox[{"lagrangianBimetricToFR2", ",", 
     RowBox[{
      RowBox[{"s_Symbol", "[", "args__", "]"}], "/;", 
      RowBox[{"Not", "[", 
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "Times", ",", "Plus", ",", "Power", ",", "Divide", ",", " ", 
           "Rational", ",", "del"}], "}"}], ",", "s"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.956646215768217*^9, 3.956646264714327*^9}, {
   3.956646326820408*^9, 3.956646349466403*^9}, {3.9566463944321165`*^9, 
