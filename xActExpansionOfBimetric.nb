Cell["\<\
We shall proceed with doing field redefinitions on our result, introducing \
the Fierz-Pauli mass and simplifying the result somewhat.
We will do this order by order.\
\>", "Text",
 CellChangeTimes->{{3.9464399721042585`*^9, 3.9464399995477333`*^9}, {
  3.947232343041916*^9, 3.947232399463788*^9}, {3.947232510472855*^9, 
  3.947232526063154*^9}, {3.9472326108733826`*^9, 
  3.9472326117613373`*^9}},ExpressionUUID->"85cf6060-6916-4014-9ee7-\
e0a9c2028d9d"],

Cell["\<\
Field redefinition:
h[inds1_,inds2_]\[Rule] \
c/(Sqrt[mg^2+c^2*mf^2])*Sqrt[2]*(1/c*\[Delta]G[inds1,inds2]-mf/mg*\[Delta]M[\
inds1,inds2]) 
and
\[Delta]f[inds3_,inds4_]\[Rule]c/(Sqrt[mg^2+c^2*mf^2])*Sqrt[2]*(c*\[Delta]G[\
inds3,inds4]+mg/mf*\[Delta]M[inds3,inds4]).\
\>", "Text",
 CellChangeTimes->{{3.9464400049502025`*^9, 3.9464400114968348`*^9}, {
   3.9464400462214613`*^9, 3.946440070781458*^9}, {3.9464401011083*^9, 
   3.946440106566104*^9}, {3.9464401414384365`*^9, 3.9464401455131392`*^9}, {
   3.94644019337197*^9, 3.9464402285624466`*^9}, {3.9464696301282187`*^9, 
   3.9464696606663237`*^9}, {3.946519461612443*^9, 3.9465194678227777`*^9}, {
   3.9465408426670294`*^9, 3.9465408832447414`*^9}, {3.9465409159808645`*^9, 
   3.9465409168008614`*^9}, {3.946543883332368*^9, 3.946543907349313*^9}, {
   3.946543961675582*^9, 3.9465440119805293`*^9}, {3.9469849988787403`*^9, 
   3.9469850096025524`*^9}, {3.9472323694999743`*^9, 3.9472323705630054`*^9}, 
   3.9594817577895308`*^9},ExpressionUUID->"337af805-8bd1-4fd7-ad33-\
2f35f363e55d"],

Cell["\<\
This field redefinition makes everything on the form we want, which we will \
show below.\
\>", "Text",
