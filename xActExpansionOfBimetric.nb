          RowBox[{"Sqrt", "[", "2", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "/", "c"}], "*", 
             RowBox[{"\[Delta]G", "[", 
