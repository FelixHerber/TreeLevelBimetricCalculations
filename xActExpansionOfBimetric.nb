Cell[BoxData[
 RowBox[{
  RowBox[{
  "ReplaceDoubleCovariantDerivativesOnExpandedExpression", "[", "expr_", 
   "]"}], ":=", 
  RowBox[{"expr", "/.", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Times", "[", 
      RowBox[{"x_", ",", 
       RowBox[{
        RowBox[{"CD", "[", "inds1__", "]"}], "@", 
        RowBox[{
         RowBox[{"CD", "[", "inds2__", "]"}], "@", "z_"}]}]}], "]"}], "\[RuleDelayed]", 
     RowBox[{
      RowBox[{
       RowBox[{"TotDer", "[", "inds1", "]"}], "@", 
       RowBox[{"(", 
        RowBox[{"Times", "[", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{"CD", "[", "inds2", "]"}], "@", "z"}]}], "]"}], ")"}]}], "-", 
      RowBox[{"Times", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"CD", "[", "inds1", "]"}], "@", "x"}], ",", 
        RowBox[{
         RowBox[{"CD", "[", "inds2", "]"}], "@", "z"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9379699101633816`*^9, 3.9379699391972485`*^9}, {
  3.9379703610304284`*^9, 3.937970361063445*^9}, {3.9379719993676405`*^9, 
