Cell[TextData[{
 "When expanding the square root, we will use the formula: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     InterpretationBox[
      StyleBox["c",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`c,
      Editable->False], 
     SqrtBox[
      RowBox[{"1", "+", "\[CapitalXi]"}]]}], "\[TildeTilde]", 
    RowBox[{
     InterpretationBox[
      StyleBox["c",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`c,
      Editable->False], "(", 
     RowBox[{"1", "+", 
      RowBox[{
       FractionBox["1", "2"], "\[CapitalXi]"}], "-"}]}]}], TraditionalForm]],
  ExpressionUUID->"e3b2b3ef-231b-46b5-bd03-b15be5759c7b"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "8"], 
     SuperscriptBox["\[CapitalXi]", "2"]}], "+"}], TraditionalForm]],
  ExpressionUUID->"c559ff9f-fae0-4010-ab49-13581ae64cd8"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", "16"], 
      SuperscriptBox["\[CapitalXi]", "3"]}], "-", 
     RowBox[{
      FractionBox["5", "128"], 
      SuperscriptBox["\[CapitalXi]", "4"]}]}], ")"}], TraditionalForm]],
  ExpressionUUID->"6349f181-a991-447b-a6d0-ab990aff3467"],
 ", were \[CapitalXi] is"
}], "Text",
 CellChangeTimes->{{3.9454824556562486`*^9, 3.945482541469957*^9}, {
