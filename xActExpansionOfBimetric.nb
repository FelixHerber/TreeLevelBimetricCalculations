Cell[BoxData[
 RowBox[{
  RowBox[{"RemoveTotalDerivatives", "[", "expr_", "]"}], ":=", " ", 
  RowBox[{"expr", " ", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Times", "[", 
       RowBox[{"x_", ",", 
        RowBox[{
         RowBox[{"TotDer", "[", "inds__", "]"}], "@", "y_"}]}], "]"}], 
      "\[Rule]", " ", 
      RowBox[{"Times", "[", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"TotDer", "[", "inds", "]"}], "@", "y"}]}], "]"}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{
       RowBox[{"TotDer", "[", "inds__", "]"}], "@", "y_"}], "\[Rule]", " ", 
      "0"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9379741469608097`*^9, 3.9379741472193336`*^9}, {
