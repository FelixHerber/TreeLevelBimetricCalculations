Cell[TextData[{
 "The perturbation series for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["S", 
     RowBox[{"   ", "\[Nu]"}], "\[Mu]"], "=", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["g", "\[Mu]\[Rho]"], 
      SubscriptBox["f", "\[Rho]\[Nu]"]}]]}], TraditionalForm]],ExpressionUUID->
  "35830e13-aa6f-48a4-be6d-5f2b5e7ab0d7"],
 " is needed. \nWe shall perturb ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", "\[Mu]\[Rho]"], 
    SubscriptBox["f", "\[Rho]\[Nu]"]}], TraditionalForm]],ExpressionUUID->
  "e17205d9-86b5-4ef2-9e2b-918404c87e97"],
 " about arbitrary backgrounds using  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       InterpretationBox[
        StyleBox["c",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`c,
        Editable->False], "2"], 
      SubscriptBox[
       RowBox[{
        OverscriptBox["g", "_"], " "}], "\[Mu]\[Nu]"]}], "+", " ", 
     SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"110a8b4c-8348-4284-ae6f-dab797c643bb"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       OverscriptBox["g", "_"], " "}], "\[Mu]\[Nu]"], "+", " ", 
     SubscriptBox["\[Delta]g", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"cda9aa5c-af42-4a17-9a00-af7812a73014"],
 ".  \nFirst, we expand the expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["g", 
     RowBox[{"-", "1"}]], "f"}], TraditionalForm]],ExpressionUUID->
  "44ae3be8-54b9-482c-9f0d-00487d01c290"],
 " or insideSquareRoot about backgrounds ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     SubscriptBox[
      OverscriptBox["f", "_"], "\[Mu]\[Nu]"], "+", " ", 
     SubscriptBox["\[Delta]f", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"3227c1e1-63d3-448b-8a4f-82a4b948ceb8"],
 "  and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{
       OverscriptBox["g", "_"], " "}], "\[Mu]\[Nu]"], "+", " ", 
     SubscriptBox["\[Delta]g", "\[Mu]\[Nu]"]}]}], TraditionalForm]],
  ExpressionUUID->"eeca1cc1-85de-4085-905f-adf4495ac966"],
 ":"
}], "Text",
 CellChangeTimes->{{3.94543856597803*^9, 3.94543861203205*^9}, {
