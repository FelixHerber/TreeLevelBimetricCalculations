Cell[BoxData[
 RowBox[{
  RowBox[{"firstPolynomial", "=", 
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"\[Theta]", ",", 
      RowBox[{"-", "\[Theta]"}]}], "]"}], "//", "Simplification"}]}], 
  ";"}]], "Input",
