Cell[BoxData[
 RowBox[{
  RowBox[{"secondPolynomial", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"S", "[", 
          RowBox[{"\[Theta]", ",", 
           RowBox[{"-", "\[Theta]"}]}], "]"}], 
         RowBox[{"S", "[", 
          RowBox[{"\[Phi]", ",", 
           RowBox[{"-", "\[Phi]"}]}], "]"}]}], "-", 
