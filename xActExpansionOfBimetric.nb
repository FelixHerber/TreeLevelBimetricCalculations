             RowBox[{
              RowBox[{"mg", "^", "2"}], "+", 
              RowBox[{
               RowBox[{"c", "^", "2"}], "*", 
               RowBox[{"mf", "^", "2"}]}]}], "]"}], ")"}]}], "*", 
          RowBox[{"Sqrt", "[", "2", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"c", "*", 
             RowBox[{"\[Delta]G", "[", 
              RowBox[{"inds3", ",", "inds4"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"mg", "/", "mf"}], "*", 
             RowBox[{"\[Delta]M", "[", 
              RowBox[{"inds3", ",", "inds4"}], "]"}]}]}], ")"}]}]}], ",", " ", 
        RowBox[{
         InterpretationBox[
          StyleBox["\[Beta]2",
           ShowAutoStyles->False,
           AutoSpacing->False],
          $CellContext`\[Beta]2,
          Editable->False], "\[Rule]", 
         FractionBox[
          RowBox[{
           RowBox[{
            InterpretationBox[
