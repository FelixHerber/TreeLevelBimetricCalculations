Cell[BoxData[
 RowBox[{"lagrangianInteractionS", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Beta]0", "*", "zerothInteraction"}], "+", 
       RowBox[{"\[Beta]1", "*", "firstInteraction"}], "+", 
       RowBox[{"\[Beta]2", "*", "secondInteraction"}], "+", 
       RowBox[{"\[Beta]3", "*", "thirdInteraction"}], "+", 
       RowBox[{"\[Beta]4", "*", "fourthInteraction"}]}], "//", 
      "Simplification"}], "//", "ContractMetric"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "m", ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds5_", ",", "inds6_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds7_", ",", "inds8_"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds5_", ",", "inds5_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds6_", ",", "inds7_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds5_", ",", "inds5_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds6_", ",", "inds7_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds5_", ",", "inds5_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds6_", ",", "inds7_"}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds5_", ",", "inds5_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds6_", ",", "inds7_"}], "]"}]}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds5_", ",", "inds6_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds5_", ",", "inds6_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds5_", ",", "inds6_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds5_", ",", "inds6_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"\[Delta]f", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"inds1_", ",", "inds2_"}], "]"}], 
       RowBox[{"h", "[", 
        RowBox[{"inds3_", ",", "inds4_"}], "]"}]}], ",", 
      RowBox[{"\[Delta]f", "[", 
       RowBox[{"inds1_", ",", "inds2_"}], "]"}], ",", 
      RowBox[{"h", "[", 
